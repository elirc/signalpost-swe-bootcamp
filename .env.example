# Copy to .env; never commit credentials. Compose's sample passwords are local only.
DATABASE_URL=postgres://signalpost:local-only-change-me@127.0.0.1:5432/signalpost
INGEST_DATABASE_URL=postgres://signalpost_ingest:local-ingest-only@127.0.0.1:5432/signalpost
QUERY_DATABASE_URL=postgres://signalpost_query:local-query-only@127.0.0.1:5432/signalpost
REDIS_URL=redis://127.0.0.1:6379
INGEST_HOST=127.0.0.1
INGEST_PORT=4318
INGEST_MAX_CONCURRENT=16
INGEST_REQUESTS_PER_MINUTE=120
# Create scoped tokens with npm run bootstrap; enter the read token in the local UI.
OTEL_SERVICE_NAME=signalpost-ingest
# Optional; collector endpoint must be independent of this receiver to prevent a loop.
OTEL_EXPORTER_OTLP_ENDPOINT=
